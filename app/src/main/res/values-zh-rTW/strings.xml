    <!-- 版面引導提示遮罩 -->
    <string name="layout_tip_title">探索多種螢幕版面</string>
    <string name="layout_tip_desc">除了全螢幕時鐘外，你隨時可以在「設定」中切換成雙區塊版面，一邊看時鐘、一邊同步掌握迷你月曆與即時天氣！</string>
    <string name="layout_tip_single">單一區塊</string>
    <string name="layout_tip_dual_left">雙區塊 (左大右小)</string>
    <string name="layout_tip_dual_right">雙區塊 (右大左小)</string>

    <!-- 非摺疊裝置彩蛋與提示 -->
    <string name="btn_not_foldable">不是大摺疊機？</string>
    <string name="toast_liar_foldable">別騙人了，你明明就是大摺</string>
    <string name="pref_hinge_unsupported">此裝置不具備轉軸感應器，非摺疊機</string>
    <string name="non_fold_dialog_title">哎呀...真可惜呢...</string>
    <string name="non_fold_dialog_desc">此 APP 是針對大摺疊機所設計的，一般手機不具備讀取轉軸角度數值功能，是沒辦法觸發進入桌面時鐘模式的。\n但...如果你願意幫我衝一下人氣，追蹤我的社群平台，那我或許可以考慮給你個例外...🤔</string>
    <string name="non_fold_btn_reject">滿腦子都只想到自己呢</string>
    <string name="non_fold_btn_accept">求求你，我什麼都願意做的</string>
    <string name="toast_reject_1">真不敢相信...</string>
    <string name="toast_reject_2">你是來找我吵架的嗎？</string>
    <string name="toast_reject_3">（跪著哭泣）</string>
    <string name="toast_accept_thanks">感謝您讓我佔用寶貴的時間！</string>
    <string name="toast_accept_permanent">好啦，以後不提醒你了，盡情使用吧！</string>

